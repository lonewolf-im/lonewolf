<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:foaf="http://xmlns.com/foaf/0.1/"
         xmlns:xmpp="https://linkmauve.fr/ns/xmpp-doap#"
         xmlns:schema="https://schema.org/"
         xmlns="http://usefulinc.com/ns/doap#">
  <Project>
    <name>Lonewolf</name>
    <shortdesc xml:lang="en">A standalone XMPP server written in Rust</shortdesc>
    <description xml:lang="en">Lonewolf is a self-hosted XMPP server written in Rust. It runs as a single binary with embedded storage, so there's no database to set up. It's still early: today it handles chat between accounts on the domains you run, and federation with other servers is on the way.</description>
    <created>2026-09-17</created>

    <homepage rdf:resource="https://github.com/lonewolf-im/lonewolf"/>
    <download-page rdf:resource="https://github.com/lonewolf-im/lonewolf/releases"/>
    <bug-database rdf:resource="https://github.com/lonewolf-im/lonewolf/issues"/>
    <schema:logo rdf:resource="https://raw.githubusercontent.com/lonewolf-im/lonewolf/main/.github/images/lonewolf.png"/>
    <license rdf:resource="http://usefulinc.com/doap/licenses/asl20"/>

    <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-server"/>
    <programming-language>Rust</programming-language>
    <os>Linux</os>
    <os>macOS</os>

    <maintainer>
      <foaf:Person>
        <foaf:name>Miguel Ángel Ortuño</foaf:name>
        <foaf:homepage rdf:resource="https://github.com/ortuman"/>
      </foaf:Person>
    </maintainer>

    <repository>
      <GitRepository>
        <location rdf:resource="https://github.com/lonewolf-im/lonewolf.git"/>
        <browse rdf:resource="https://github.com/lonewolf-im/lonewolf"/>
      </GitRepository>
    </repository>

    <release>
      <Version>
        <revision>0.2.0</revision>
        <created>2026-10-27</created>
        <file-release rdf:resource="https://github.com/lonewolf-im/lonewolf/archive/refs/tags/v0.2.0.tar.gz"/>
      </Version>
    </release>

    <release>
      <Version>
        <revision>0.1.0</revision>
        <created>2026-10-19</created>
        <file-release rdf:resource="https://github.com/lonewolf-im/lonewolf/archive/refs/tags/v0.1.0.tar.gz"/>
      </Version>
    </release>

    <implements rdf:resource="https://www.rfc-editor.org/info/rfc6120"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc2782"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc5280"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc9525"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc6121"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc7590"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc7622"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc4422"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc5802"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc7677"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc4013"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc5929"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc9266"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc9325"/>

    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0030.html"/>
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>2.5.0</xmpp:version>
        <xmpp:since>0.2.0</xmpp:since>
        <xmpp:note xml:lang="en">Federation support is not in a release yet.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0054.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:version>1.3.0</xmpp:version>
        <xmpp:since>0.2.0</xmpp:since>
        <xmpp:note xml:lang="en">Public vCards for local and federated users. Only owners can edit them; contents are not validated. Federation support is not in a release yet.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0160.html"/>
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>1.0.1</xmpp:version>
        <xmpp:since>0.1.0</xmpp:since>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0178.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:version>1.2</xmpp:version>
        <xmpp:since>0.1.0</xmpp:since>
        <xmpp:note xml:lang="en">Certificate login for clients and servers. S2S requires serverAuth certificates and does not check revocation. Server-to-server support is not in a release yet.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0199.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:version>2.0.1</xmpp:version>
        <xmpp:since>0.2.0</xmpp:since>
        <xmpp:note xml:lang="en">Answers pings but never sends its own. Federation support is not in a release yet.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0203.html"/>
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>2.0</xmpp:version>
        <xmpp:since>0.1.0</xmpp:since>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0280.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:version>1.0.1</xmpp:version>
        <xmpp:since>0.2.0</xmpp:since>
        <xmpp:note xml:lang="en">Copies local and federated messages across sessions that enable Carbons. Private group-chat messages receive no special handling. Federation support is not in a release yet.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0297.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:version>1.0</xmpp:version>
        <xmpp:since>0.2.0</xmpp:since>
        <xmpp:note xml:lang="en">Used only for Message Carbons copies.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0440.html"/>
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>1.0.0</xmpp:version>
        <xmpp:since>0.1.0</xmpp:since>
      </xmpp:SupportedXep>
    </implements>
  </Project>
</rdf:RDF>

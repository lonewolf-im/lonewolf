<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xmpp="https://linkmauve.fr/ns/xmpp-doap#"
         xmlns:schema="https://schema.org/"
         xmlns="http://usefulinc.com/ns/doap#">
  <Project>
    <name>Lonewolf</name>
    <shortdesc xml:lang="en">A standalone XMPP server written in Rust</shortdesc>
    <description xml:lang="en">Lonewolf is a self-hosted XMPP server written in Rust. It runs as one binary with embedded storage, so there is no separate database to set up. It is early, pre-1.0 software that hosts chat between accounts on the domains you run. Server connections use STARTTLS and SASL EXTERNAL. Local clients can send messages, IQs and ordinary presence to remote domains, including directed withdrawals and initial roster probes. Inbound messages support local delivery, offline storage and recipient Carbons. Inbound IQs use existing handlers and recipient policy, with replies on separate outbound streams; full-JID responses reach local resources. Inbound available and unavailable presence reaches local resources through recipient policy. Inbound probes use presence authorization and directed-recipient grants; replies preserve bare-account privacy and use separate outbound streams. Presence errors reach local resources. Outbound subscriptions follow RFC 6121 Appendix A.2 and update only the local owner's roster. Remote-contact removal and account deletion send subscription withdrawals. Inbound subscriptions follow RFC 6121 Appendix A.3 with recipient policy and update only the local owner's roster, including pending-request replay and preapproval. Federated roster subscriptions require account contacts with a localpart. Roster silently ignores inbound domain-only subscription senders; outbound subscriptions to domain-only contacts remain unsupported. Registered hosted services receive federated messages, IQs and presence through their service handlers and can send through bounded outbound links. Service dispatch bypasses account policy, archives and observers. Federation requires global enablement and a current certificate from a federating host that covers the service domain through DNS-ID, SRV-ID or domain-only xmppAddr. Selection uses sorted host order and pins the checked certificate generation for each service TLS configuration in both directions. Service SNI must name that service, or be absent. Managed certificates name only their host and cannot cover distinct service domains. Federation support is not in a release yet.</description>

    <homepage rdf:resource="https://github.com/lonewolf-im/lonewolf"/>
    <download-page rdf:resource="https://github.com/lonewolf-im/lonewolf/releases"/>
    <bug-database rdf:resource="https://github.com/lonewolf-im/lonewolf/issues"/>
    <schema:logo rdf:resource="https://raw.githubusercontent.com/lonewolf-im/lonewolf/main/.github/images/lonewolf.png"/>
    <license rdf:resource="http://usefulinc.com/doap/licenses/asl20"/>

    <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-server"/>
    <programming-language>Rust</programming-language>
    <os>Linux</os>
    <os>macOS</os>

    <repository>
      <GitRepository>
        <location rdf:resource="https://github.com/lonewolf-im/lonewolf.git"/>
        <browse rdf:resource="https://github.com/lonewolf-im/lonewolf"/>
      </GitRepository>
    </repository>

    <release>
      <Version>
        <revision>0.2.0</revision>
        <created>2026-10-27</created>
      </Version>
    </release>

    <release>
      <Version>
        <revision>0.1.0</revision>
        <created>2026-10-19</created>
      </Version>
    </release>

    <implements rdf:resource="https://www.rfc-editor.org/info/rfc6120"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc2782"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc5280"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc9525"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc6121"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc7590"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc7622"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc4422"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc5802"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc7677"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc4013"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc5929"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc9266"/>
    <implements rdf:resource="https://www.rfc-editor.org/info/rfc9325"/>

    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0030.html"/>
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>2.5.0</xmpp:version>
        <xmpp:note xml:lang="en">Server and account queries from authenticated federated users use the same presence authorization as local non-owners. Not in a release yet.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0054.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:version>1.3.0</xmpp:version>
        <xmpp:note xml:lang="en">Account vCards support public retrieval by authenticated local users and users of federated domains; remote replacement is forbidden. No schema validation. Not in a release yet.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0160.html"/>
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>1.0.1</xmpp:version>
        <xmpp:since>0.1.0</xmpp:since>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0178.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:version>1.2</xmpp:version>
        <xmpp:note xml:lang="en">Client certificate authentication and partial server STARTTLS and EXTERNAL support in both directions. Server peers require a valid certificate for their domain with explicit serverAuth EKU; authenticated streams close at certificate expiry. Inbound messages use recipient policy, received archives, local delivery and offline storage; eligible rejections and IQ replies use separate outbound streams. Local clients can send messages and IQs over authenticated outbound streams with sender policy and archive processing, sender Carbons, and eligible error bounces. Outbound available, unavailable, probe and error presence includes broadcasts, directed withdrawals and initial roster probes. Inbound IQs use existing server/account handlers and recipient policy, with presence authorization for full-JID requests and endpoint routing for responses. Session IQ controls remain local. Inbound available and unavailable presence reaches local resources through recipient policy. Inbound probes use presence authorization and directed-recipient grants; replies preserve bare-account privacy and use separate outbound streams. Presence errors reach local resources. Outbound subscriptions follow RFC 6121 Appendix A.2 and update only the local owner's roster. Remote-contact removal and account deletion send subscription withdrawals. Inbound subscriptions follow RFC 6121 Appendix A.3 with recipient policy and update only the local owner's roster, including pending-request replay and preapproval. Federated roster subscriptions require account contacts with a localpart. Roster silently ignores inbound domain-only subscription senders; outbound subscriptions to domain-only contacts remain unsupported. Registered hosted services receive federated messages, IQs and presence through their service handlers and can send through bounded outbound links. Service dispatch bypasses account policy, archives and observers. Federation requires global enablement and a current certificate from a federating host that covers the service domain through DNS-ID, SRV-ID or domain-only xmppAddr. Selection uses sorted host order and pins the checked certificate generation for each service TLS configuration in both directions. Service SNI must name that service, or be absent. Managed certificates name only their host and cannot cover distinct service domains. S2S orderly closure exchanges XML footers before TLS close alerts and a clean TLS end, bounded by shutdown and certificate expiry. Workflows cover TLS 1.2 and TLS 1.3 in both directions. Server certificate revocation is not checked. Server support: Not in a release yet.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0199.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:version>2.0.1</xmpp:version>
        <xmpp:note xml:lang="en">Answers client and authenticated federated pings but does not send its own. Not in a release yet.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0203.html"/>
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>2.0</xmpp:version>
        <xmpp:since>0.1.0</xmpp:since>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0280.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:version>1.0.1</xmpp:version>
        <xmpp:note xml:lang="en">Local session control and sender/recipient copies, including sender copies for messages admitted for outbound federation and recipient copies for delivered or stored inbound federated messages. MUC Multi-Session Nick handling remains unsupported. Federation support: Not in a release yet.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0297.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:version>1.0</xmpp:version>
        <xmpp:since>0.2.0</xmpp:since>
        <xmpp:note xml:lang="en">Used only for Message Carbons copies.</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0440.html"/>
        <xmpp:status>complete</xmpp:status>
        <xmpp:version>1.0.0</xmpp:version>
        <xmpp:since>0.1.0</xmpp:since>
      </xmpp:SupportedXep>
    </implements>
  </Project>
</rdf:RDF>
